{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReservationEmailExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["language","customer_name","phone","email","pickup","return","vehicle","competitor","multiple_requests","message_intent","ambiguities","confidence"],
  "properties": {
    "language": {"type":"string","minLength":2,"maxLength":12},
    "customer_name": {"type":["string","null"]},
    "phone": {"type":["string","null"]},
    "email": {"type":["string","null"]},
    "pickup": {
      "type":"object","additionalProperties":false,
      "required":["date_text","date_iso","time_text","location"],
      "properties": {
        "date_text":{"type":["string","null"]},
        "date_iso":{"type":["string","null"],"description":"YYYY-MM-DD only when safely resolvable from explicit evidence/context"},
        "time_text":{"type":["string","null"]},
        "location":{"type":["string","null"]}
      }
    },
    "return": {
      "type":"object","additionalProperties":false,
      "required":["date_text","date_iso","time_text","location"],
      "properties": {
        "date_text":{"type":["string","null"]},
        "date_iso":{"type":["string","null"]},
        "time_text":{"type":["string","null"]},
        "location":{"type":["string","null"]}
      }
    },
    "vehicle": {
      "type":"object","additionalProperties":false,
      "required":["category","transmission","model_text"],
      "properties": {
        "category":{"type":["string","null"]},
        "transmission":{"type":["string","null"],"enum":["automatic","manual","unspecified",null]},
        "model_text":{"type":["string","null"]}
      }
    },
    "competitor": {
      "type":"object","additionalProperties":false,
      "required":["price_mentioned","price_text"],
      "properties": {
        "price_mentioned":{"type":"boolean"},
        "price_text":{"type":["string","null"]}
      }
    },
    "multiple_requests":{"type":"boolean"},
    "message_intent":{"type":"string","enum":["new_request","follow_up","correction","price_question","availability_question","other"]},
    "ambiguities":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["code","severity","detail"],
        "properties":{
          "code":{"type":"string"},
          "severity":{"type":"string","enum":["low","medium","high"]},
          "detail":{"type":"string"}
        }
      }
    },
    "confidence":{"type":"number","minimum":0,"maximum":1}
  }
}
